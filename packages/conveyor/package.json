{
	"name": "@autoinvent/conveyor",
	"version": "2.0.0-beta",
	"author": "Moebius Solutions",
	"description": "UI component library for model based data.",
	"license": "BlueOak-1.0.0",
	"keywords": [],
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/conveyor.umd.cjs",
	"module": "./dist/conveyor.js",
	"types": "./dist/src/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/src/index.d.ts",
				"default": "./dist/conveyor.js"
			},
			"require": "./dist/conveyor.umd.cjs"
		},
		"./styles.css": "./dist/index.css"
	},
	"scripts": {
		"lint": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
		"clean": "rm -rf dist",
		"build": "bun run build:css && vite build && tsc",
		"build:css": "bunx @tailwindcss/cli -i ./src/index.css -o ./public/index.css"
	},
	"dependencies": {
		"@repo/internal": "workspace:*"
	},
	"peerDependencies": {
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.5",
		"@tailwindcss/cli": "^4.1.14",
		"@tailwindcss/vite": "^4.1.14",
		"@types/bun": "^1.2.23",
		"@vitejs/plugin-react": "^5.0.4",
		"tailwindcss": "^4.1.14",
		"typescript": "^5.9.3",
		"vite": "^7.1.9"
	}
}
